  gameTitle: CIPHER
  caseTitle: "\u0423\u0442\u0435\u0447\u043A\u0430 \u0434\u0430\u043D\u043D\u044B\u0445
    \u0432 \xAB\u041D\u043E\u0432\u0430 \u0421\u043E\u0444\u0442\xBB"
  briefing: "\u0410\u0433\u0435\u043D\u0442, \u044D\u0442\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
    \u0438\u0437 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \xAB\u041D\u043E\u0432\u0430
    \u0421\u043E\u0444\u0442\xBB \u0443\u0442\u0435\u043A\u043B\u0430 \u0431\u0430\u0437\u0430
    \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432. \u041F\u043E\u0434 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435\u043C
    \u0442\u0440\u043E\u0435: \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440
    \u041C\u0430\u0440\u0438\u043D\u0430 \u0411\u0435\u043B\u043E\u0432\u0430, \u0441\u0438\u0441\u0430\u0434\u043C\u0438\u043D
    \u041E\u043B\u0435\u0433 \u041A\u043E\u0432\u0430\u043B\u0451\u0432 \u0438 \u0414\u0435\u043D\u0438\u0441
    \u0415\u0440\u0448\u043E\u0432, \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A,
    \u0443\u0432\u043E\u043B\u0435\u043D\u043D\u044B\u0439 \u043C\u0435\u0441\u044F\u0446
    \u043D\u0430\u0437\u0430\u0434.\n\n\u0421\u043B\u0435\u0434\u044B \u0430\u0442\u0430\u043A\u0438
    \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043F\u0440\u044F\u043C\u043E
    \u0432 \u044D\u0442\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435. \u041D\u0430\u0439\u0434\u0438\u0442\u0435
    \u0443\u043B\u0438\u043A\u0438, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
    \u0445\u043E\u0434 \u0430\u0442\u0430\u043A\u0438 \u0438 \u043D\u0430\u0437\u043E\u0432\u0438\u0442\u0435
    \u0432\u0438\u043D\u043E\u0432\u043D\u043E\u0433\u043E. \u0421\u043B\u0435\u0434\u0438\u0442\u0435
    \u0437\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0441\u043E\u0431\u044B\u0442\u0438\u0439:
    \u043E\u043D\u043E \u0435\u0441\u0442\u044C \u0443 \u043A\u0430\u0436\u0434\u043E\u0439
    \u0443\u043B\u0438\u043A\u0438. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u043B\u0435\u0434\u044B \u0432\u0438\u0434\u043D\u044B \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432 \u0443\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u0435."
  clues:
  - {fileID: 7751706157676846991, guid: 50f381d272cac7f42aed7d477156372a, type: 3}
  - {fileID: 545857324546192356, guid: 36880168b9e1aed4a9818a73b9e22244, type: 3}
  - {fileID: 5319609694658388021, guid: 241e9a2e3ab184d4ea061850637b1f3e, type: 3}
  - {fileID: 3695136488198498304, guid: 101ae8004f5d7c8478536ed3c32fff2e, type: 3}
  - {fileID: 6850077923451868714, guid: 08cf71a7de3dfb4459bcac5a03722c56, type: 3}
  - {fileID: 2879403631331306863, guid: 0216f150fac8f3f4398c6c6b8c9a6d8f, type: 3}
  - {fileID: 3955790947511703097, guid: 379a601aa68990147845c7413889d4fa, type: 3}
  boardTask: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
    \u0445\u043E\u0434 \u0430\u0442\u0430\u043A\u0438: \u0432\u044B\u0431\u0438\u0440\u0430\u0439\u0442\u0435
    \u0443\u043B\u0438\u043A\u0438 \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443,
    \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0448\u0430\u0433\u0430
    \u0437\u043B\u043E\u0443\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u0438\u043A\u0430
    \u043A \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C\u0443."
  solvedText: "\u0426\u0435\u043F\u043E\u0447\u043A\u0430 \u0441\u043B\u043E\u0436\u0438\u043B\u0430\u0441\u044C:
    \u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E
    \u2192 \u0443\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u044B\u0439 \u043F\u0430\u0440\u043E\u043B\u044C
    \u2192 \u0431\u044D\u043A\u0434\u043E\u0440 \u0441 \u0444\u043B\u0435\u0448\u043A\u0438
    \u2192 \u043D\u043E\u0447\u043D\u043E\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
    \u2192 \u0432\u044B\u0433\u0440\u0443\u0437\u043A\u0430 \u0431\u0430\u0437\u044B.
    \u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u043D\u044F\u0442\u044C,
    \u043A\u0442\u043E \u0437\u0430 \u044D\u0442\u0438\u043C \u0441\u0442\u043E\u0438\u0442."
  suspectTask: "\u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0441\u043E\u0431\u044B\u0442\u0438\u0439 \u0438 \u0441\u043B\u0435\u0434\u044B
    \u043D\u0430 \u0443\u043B\u0438\u043A\u0430\u0445. \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
    \u043F\u0440\u0438\u0446\u0435\u043B \u043D\u0430 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E
    \u0438 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C \u044D\u043A\u0440\u0430\u043D\u0430."
  suspects:
  - name: "\u041C\u0430\u0440\u0438\u043D\u0430 \u0411\u0435\u043B\u043E\u0432\u0430"
    role: "\u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440"
    suspicion: "\u0415\u0451 \u043F\u0430\u0440\u043E\u043B\u044C, \u0435\u0451 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
      \u0444\u043B\u0435\u0448\u043A\u0430 \u0438\u0437 \u0435\u0451 \u043F\u043E\u0441\u044B\u043B\u043A\u0438."
    explanation: "\u041C\u0430\u0440\u0438\u043D\u0430 \u0443\u0448\u043B\u0430 \u0438\u0437
      \u043E\u0444\u0438\u0441\u0430 \u0432 18:30, \u0430 \u0432\u044B\u0433\u0440\u0443\u0437\u043A\u0430
      \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u0432 03:15 \u0447\u0435\u0440\u0435\u0437
      \u0443\u0434\u0430\u043B\u0451\u043D\u043D\u044B\u0439 \u0434\u043E\u0441\u0442\u0443\u043F.
      \u041E\u043D\u0430 \u0436\u0435\u0440\u0442\u0432\u0430 \u043E\u0431\u043C\u0430\u043D\u0430:
      \u043F\u0438\u0441\u044C\u043C\u043E \u0438 \u043F\u043E\u0441\u044B\u043B\u043A\u0443
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
      \u0434\u043B\u044F \u043D\u0435\u0451."
    isCulprit: 0
    color: {r: 1, g: 0.82, b: 0.25, a: 1}
  - name: "\u041E\u043B\u0435\u0433 \u041A\u043E\u0432\u0430\u043B\u0451\u0432"
    role: "\u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440"
    suspicion: "\u0415\u0433\u043E \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A
      \u0443 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430, \u043D\u043E\u0447\u044C\u044E
      \u043E\u043D \u0431\u044B\u043B \u0432 \u043E\u0444\u0438\u0441\u0435."
    explanation: "\u041E\u043B\u0435\u0433 \u0432\u043E\u0448\u0451\u043B \u0432
      03:38, \u043A\u043E\u0433\u0434\u0430 \u0443\u0442\u0435\u0447\u043A\u0430
      \u0443\u0436\u0435 \u0448\u043B\u0430. \u0412 03:41 \u0432\u044B\u0433\u0440\u0443\u0437\u043A\u0430
      \u043E\u0431\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C: \u044D\u0442\u043E
      \u043E\u043D \u043F\u043E \u0442\u0440\u0435\u0432\u043E\u0433\u0435 \u0432\u044B\u0434\u0435\u0440\u043D\u0443\u043B
      \u0441\u0435\u0442\u0435\u0432\u043E\u0439 \u043A\u0430\u0431\u0435\u043B\u044C
      \u0438 \u0441\u043F\u0430\u0441 28 000 \u0437\u0430\u043F\u0438\u0441\u0435\u0439.
      \u041E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E\u0433\u0434\u0430."
    isCulprit: 0
    color: {r: 0.4, g: 1, b: 1, a: 1}
  - name: "\u0414\u0435\u043D\u0438\u0441 \u0415\u0440\u0448\u043E\u0432"
    role: "\u0431\u044B\u0432\u0448\u0438\u0439 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A"
    suspicion: "\u0423\u0432\u043E\u043B\u0435\u043D \u043C\u0435\u0441\u044F\u0446
      \u043D\u0430\u0437\u0430\u0434, \u0437\u043D\u0430\u0435\u0442 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438."
    explanation: "\u0414\u0432\u0430 \u0441\u043B\u0435\u0434\u0430 \u0432\u0435\u0434\u0443\u0442
      \u043A \u0414\u0435\u043D\u0438\u0441\u0443: \u0430\u0432\u0442\u043E\u0440
      \u0431\u044D\u043A\u0434\u043E\u0440\u0430 \u043D\u0430 \u0444\u043B\u0435\u0448\u043A\u0435
      \u2014 DErshov-PC, \u0430 \u043D\u043E\u0447\u044C\u044E \u0441 \u0442\u043E\u0433\u043E
      \u0436\u0435 \u0430\u0434\u0440\u0435\u0441\u0430 203.0.113.66, \u043A\u0443\u0434\u0430
      \u0443\u0448\u043B\u0438 \u0434\u0430\u043D\u043D\u044B\u0435, \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0432\u043E\u0439\u0442\u0438 \u043F\u043E\u0434 \u0435\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u0439
      \u0443\u0447\u0451\u0442\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u044C\u044E.
      \u041E\u043D \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B \u043F\u0438\u0441\u044C\u043C\u043E
      \u0438 \u043F\u043E\u0441\u044B\u043B\u043A\u0443, \u0430 \u043D\u043E\u0447\u044C\u044E
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u043B \u0431\u044D\u043A\u0434\u043E\u0440\u043E\u043C
      \u0438\u0437 \u0434\u043E\u043C\u0430."
    isCulprit: 1
    color: {r: 1, g: 0.3, b: 0.35, a: 1}
  futureTitle: "2030 \xB7 \u0421\u0418\u0421\u0422\u0415\u041C\u0410 \u0417\u0410\u0429\u0418\u0429\u0415\u041D\u0410"
  finalText: "\u0414\u0435\u043D\u0438\u0441 \u0415\u0440\u0448\u043E\u0432 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D.
    \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u041E\u043B\u0435\u0433\u0443
    28 000 \u0437\u0430\u043F\u0438\u0441\u0435\u0439 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
    \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
    \u041C\u0430\u0440\u0438\u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u0430 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
    \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u0435\u0440\u0432\u043E\u0439
    \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u043F\u0438\u0441\u044C\u043C\u0430. \u0412 \xAB\u041D\u043E\u0432\u0430 \u0421\u043E\u0444\u0442\xBB
    \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u0434\u0432\u0443\u0445\u0444\u0430\u043A\u0442\u043E\u0440\u043D\u0443\u044E
    \u0437\u0430\u0449\u0438\u0442\u0443, \u043E\u043F\u043E\u0432\u0435\u0449\u0435\u043D\u0438\u044F
    \u043E \u043D\u043E\u0447\u043D\u043E\u043C \u0442\u0440\u0430\u0444\u0438\u043A\u0435
    \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u044E\u0442 \u0434\u043E\u0441\u0442\u0443\u043F
    \u0443\u0432\u043E\u043B\u0435\u043D\u043D\u044B\u043C \u0432 \u0442\u043E\u0442
    \u0436\u0435 \u0434\u0435\u043D\u044C."
