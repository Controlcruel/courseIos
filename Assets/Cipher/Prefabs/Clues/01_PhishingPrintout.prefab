--- !u!114 &7751706157676846991
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6740599086196805628}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 009fff01f5efc6b4ea7e57f122620268, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cipher.CipherClue
  title: "\u041F\u0438\u0441\u044C\u043C\u043E \xAB\u043E\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438\xBB"
  time: 18:02
  description: "\u0420\u0430\u0441\u043F\u0435\u0447\u0430\u0442\u043A\u0430 \u043F\u0438\u0441\u044C\u043C\u0430,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u041C\u0430\u0440\u0438\u043D\u0430
    \u0411\u0435\u043B\u043E\u0432\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
    \u0432 18:02: \xAB\u0421\u0440\u043E\u0447\u043D\u043E \u0441\u043C\u0435\u043D\u0438\u0442\u0435
    \u043F\u0430\u0440\u043E\u043B\u044C \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
    \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0441\u043A\u043E\u0439
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B \u0441 \u0444\u043B\u0435\u0448\u043A\u0438
    \u0438\u0437 \u043F\u043E\u0441\u044B\u043B\u043A\u0438\xBB. \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
    support@nova-soft.co, \u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0434\u043E\u043C\u0435\u043D \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    nova-soft.ru. \u041F\u043E\u0434\u043F\u0438\u0441\u044C \xAB\u041E\u0442\u0434\u0435\u043B
    \u0418\u0422\xBB, \u0445\u043E\u0442\u044F \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0441\u0438\u0441\u0430\u0434\u043C\u0438\u043D, \u041E\u043B\u0435\u0433 \u041A\u043E\u0432\u0430\u043B\u0451\u0432,
    \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u0432\u043E\u0438\u043C \u0438\u043C\u0435\u043D\u0435\u043C."
  lesson: "\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u0430\u0434\u0440\u0435\u0441
    \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F \u0438 \u043D\u0435
    \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438 \u043F\u043E \u0441\u0441\u044B\u043B\u043A\u0430\u043C
    \u0438\u0437 \xAB\u0441\u0440\u043E\u0447\u043D\u044B\u0445\xBB \u043F\u0438\u0441\u0435\u043C.
    \u0421\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0448\u044C\u0441\u044F \u2014
    \u043F\u043E\u0437\u0432\u043E\u043D\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044E."
  color: {r: 1, g: 0.82, b: 0.25, a: 1}
  surface: 0
  surfaceOffset: 0.015
  randomYaw: 1
  onlyVisibleInUV: 0
  scanDistance: 1.5
  scanTime: 1
