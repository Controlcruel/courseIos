--- !u!114 &2879403631331306863
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2843396328952914810}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 009fff01f5efc6b4ea7e57f122620268, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cipher.CipherClue
  title: "\u041E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A \u043F\u0430\u043B\u044C\u0446\u0430"
  time: 
  description: "\u041F\u043E\u0434 \u0423\u0424-\u0441\u0432\u0435\u0442\u043E\u043C
    \u0443 \u0441\u0435\u0442\u0435\u0432\u043E\u0433\u043E \u0440\u0430\u0437\u044A\u0451\u043C\u0430
    \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u041C\u0430\u0440\u0438\u043D\u044B
    \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A.
    \u0421\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435 \u0441 \u0431\u0430\u0437\u043E\u0439
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432: \u041E\u043B\u0435\u0433
    \u041A\u043E\u0432\u0430\u043B\u0451\u0432, \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439
    \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440,
    87%. \u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u043E\u0447\u044C\u044E \u043E\u043D
    \u0431\u044B\u043B \u0443 \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430.
    \u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u0438\u043C\u0435\u043D\u043D\u043E?"
  lesson: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0434\u043E\u0441\u0442\u0443\u043F
    \u0442\u043E\u0436\u0435 \u0443\u0433\u0440\u043E\u0437\u0430: \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440 (Win + L), \u043A\u043E\u0433\u0434\u0430
    \u043E\u0442\u0445\u043E\u0434\u0438\u0448\u044C \u043E\u0442 \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E
    \u043C\u0435\u0441\u0442\u0430."
  color: {r: 0.4, g: 1, b: 1, a: 1}
  surface: 0
  surfaceOffset: 0.012
  randomYaw: 1
  onlyVisibleInUV: 1
  scanDistance: 1
  scanTime: 1.8
  isAttackStep: 0
  attackStep: 1
  model: {fileID: 2207925606260319626}
