--- !u!114 &3955790947511703097
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6995885533777987016}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 009fff01f5efc6b4ea7e57f122620268, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cipher.CipherClue
  title: "\u0416\u0443\u0440\u043D\u0430\u043B \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u0432"
  time: 03:38
  description: "\u0422\u0435\u0440\u043C\u0438\u043D\u0430\u043B \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u0432
    \u0443 \u0434\u0432\u0435\u0440\u0438. \u0417\u0430\u043F\u0438\u0441\u0438 \u0437\u0430
    \u043D\u043E\u0447\u044C: \u041C\u0430\u0440\u0438\u043D\u0430 \u0411\u0435\u043B\u043E\u0432\u0430
    \u0432\u044B\u0448\u043B\u0430 \u0432 18:30. \u041E\u043B\u0435\u0433 \u041A\u043E\u0432\u0430\u043B\u0451\u0432
    \u0432\u043E\u0448\u0451\u043B \u0432 03:38 \u0438 \u0432\u044B\u0448\u0435\u043B
    \u0432 04:20. \u0411\u043E\u043B\u044C\u0448\u0435 \u0432 \u043E\u0444\u0438\u0441
    \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u043B."
  lesson: "\u041F\u0440\u0438 \u0442\u0440\u0435\u0432\u043E\u0433\u0435 \u0441\u0440\u0430\u0437\u0443
    \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0439 \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0439
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440 \u043E\u0442 \u0441\u0435\u0442\u0438:
    \u043A\u0430\u0436\u0434\u0430\u044F \u043C\u0438\u043D\u0443\u0442\u0430 \u043F\u0440\u043E\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u044F
    \u2014 \u043D\u043E\u0432\u044B\u0435 \u0443\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u044B\u0435
    \u0437\u0430\u043F\u0438\u0441\u0438."
  color: {r: 0.35, g: 1, b: 0.55, a: 1}
  surface: 1
  surfaceOffset: 0.01
  randomYaw: 0
  onlyVisibleInUV: 0
  scanDistance: 1.5
  scanTime: 1.2
  isAttackStep: 0
  attackStep: 1
