  m_Script: {fileID: 11500000, guid: 009fff01f5efc6b4ea7e57f122620268, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cipher.CipherClue
  title: "\u041D\u043E\u0447\u043D\u043E\u0439 \u0442\u0440\u0430\u0444\u0438\u043A"
  time: 03:12
  description: "\u0412 03:12 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u041C\u0430\u0440\u0438\u043D\u044B \u0441\u0430\u043C \u043D\u0430\u0447\u0430\u043B
    \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C \u0434\u0430\u043D\u043D\u044B\u0435
    \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440 203.0.113.66. \u0412 \u043E\u0444\u0438\u0441\u0435
    \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043D\u0438\u043A\u043E\u0433\u043E
    \u043D\u0435 \u0431\u044B\u043B\u043E: \u0431\u044D\u043A\u0434\u043E\u0440\u043E\u043C
    \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0438 \u0443\u0434\u0430\u043B\u0451\u043D\u043D\u043E.
    \u041E\u043F\u043E\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u043E \u0442\u0440\u0435\u0432\u043E\u0433\u0435
    \u0443\u0448\u043B\u043E \u0441\u0438\u0441\u0430\u0434\u043C\u0438\u043D\u0443
    \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0440\u0435\u0437 20 \u043C\u0438\u043D\u0443\u0442."
  lesson: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439 \u043C\u0435\u0436\u0441\u0435\u0442\u0435\u0432\u043E\u0439
    \u044D\u043A\u0440\u0430\u043D \u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0435
    \u043E\u043F\u043E\u0432\u0435\u0449\u0435\u043D\u0438\u044F \u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0439
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0432 \u0441\u0435\u0442\u0438,
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043D\u043E\u0447\u044C\u044E."
  color: {r: 0.25, g: 0.85, b: 1, a: 1}
  surface: 1
  surfaceOffset: 0.18
  randomYaw: 0
  onlyVisibleInUV: 0
  scanDistance: 1.5
  scanTime: 1.2
  isAttackStep: 1
  attackStep: 4
