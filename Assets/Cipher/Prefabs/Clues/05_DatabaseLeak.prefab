  m_Script: {fileID: 11500000, guid: 009fff01f5efc6b4ea7e57f122620268, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cipher.CipherClue
  title: "\u0416\u0443\u0440\u043D\u0430\u043B \u0441\u0435\u0440\u0432\u0435\u0440\u0430"
  time: 03:15
  description: "\u0421 03:15 \u043F\u043E\u0434 \u0443\u0447\u0451\u0442\u043D\u043E\u0439
    \u0437\u0430\u043F\u0438\u0441\u044C\u044E \u041C\u0430\u0440\u0438\u043D\u044B
    \u0432\u044B\u0433\u0440\u0443\u0436\u0435\u043D\u043E 12 000 \u0438\u0437 40
    000 \u0437\u0430\u043F\u0438\u0441\u0435\u0439 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432.
    \u0412 03:41 \u0432\u044B\u0433\u0440\u0443\u0437\u043A\u0430 \u043E\u0431\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C:
    \xAB\u0441\u0435\u0442\u0435\u0432\u043E\u0439 \u043A\u0430\u0431\u0435\u043B\u044C
    \u043E\u0442\u043A\u043B\u044E\u0447\u0451\u043D\xBB. \u0415\u0449\u0451 \u043E\u0434\u043D\u0430
    \u0441\u0442\u0440\u043E\u043A\u0430: \u0432 02:50 \u0441 \u0442\u043E\u0433\u043E
    \u0436\u0435 \u0430\u0434\u0440\u0435\u0441\u0430 203.0.113.66 \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
    \u0432\u043E\u0439\u0442\u0438 \u043F\u043E\u0434 \u0443\u0447\u0451\u0442\u043D\u043E\u0439
    \u0437\u0430\u043F\u0438\u0441\u044C\u044E d.ershov, \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u043C\u0435\u0441\u044F\u0446 \u043D\u0430\u0437\u0430\u0434."
  lesson: "\u0414\u0430\u0432\u0430\u0439 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0443\u0436\u043D\u044B\u0439 \u0434\u043E\u0441\u0442\u0443\u043F,
    \u0448\u0438\u0444\u0440\u0443\u0439 \u0434\u0430\u043D\u043D\u044B\u0435 \u0438
    \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0439 \u0443\u0447\u0451\u0442\u043D\u044B\u0435
    \u0437\u0430\u043F\u0438\u0441\u0438 \u0443\u0432\u043E\u043B\u0435\u043D\u043D\u044B\u0445
    \u0432 \u0434\u0435\u043D\u044C \u0443\u0445\u043E\u0434\u0430."
  color: {r: 0.7, g: 0.4, b: 1, a: 1}
  surface: 0
  surfaceOffset: 0.015
  randomYaw: 1
  onlyVisibleInUV: 0
  scanDistance: 1.5
