--- !u!114 &5319609694658388021
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5127090682275236034}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 009fff01f5efc6b4ea7e57f122620268, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cipher.CipherClue
  title: "\u0424\u043B\u0435\u0448\u043A\u0430 \u0438\u0437 \u043F\u043E\u0441\u044B\u043B\u043A\u0438"
  time: 18:10
  description: "\u0424\u043B\u0435\u0448\u043A\u0443 \u043F\u0440\u0438\u043D\u0451\u0441
    \u043A\u0443\u0440\u044C\u0435\u0440 \u0432 17:50 \u0432 \u043F\u043E\u0441\u044B\u043B\u043A\u0435
    \xAB\u043E\u0442 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430\xBB. \u0412
    18:10 \u041C\u0430\u0440\u0438\u043D\u0430, \u043A\u0430\u043A \u0432\u0435\u043B\u0435\u043B\u043E
    \u043F\u0438\u0441\u044C\u043C\u043E, \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u043B\u0430
    \u0441 \u043D\u0435\u0451 invoice_update.exe. \u042D\u0442\u043E \u0431\u044D\u043A\u0434\u043E\u0440:
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u0434\u043B\u044F \u0441\u043A\u0440\u044B\u0442\u043E\u0433\u043E
    \u0443\u0434\u0430\u043B\u0451\u043D\u043D\u043E\u0433\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043E\u043C. \u0412 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u0445
    \u0444\u0430\u0439\u043B\u0430 \u0443\u043A\u0430\u0437\u0430\u043D \u0430\u0432\u0442\u043E\u0440:
    DErshov-PC."
  lesson: "\u041D\u0435 \u0432\u0441\u0442\u0430\u0432\u043B\u044F\u0439 \u0444\u043B\u0435\u0448\u043A\u0438
    \u0438\u0437 \u043D\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0445
    \u043F\u043E\u0441\u044B\u043B\u043E\u043A \u0438 \u043D\u0435 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0439
    \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0444\u0430\u0439\u043B\u044B.
    \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u0432\u0438\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u0441\u0430\u0434\u043C\u0438\u043D."
  color: {r: 1, g: 0.25, b: 0.3, a: 1}
  surface: 2
  surfaceOffset: 0.015
  randomYaw: 1
  onlyVisibleInUV: 0
  scanDistance: 1.5
  scanTime: 1.2
  isAttackStep: 1
  attackStep: 3
  model: {fileID: 5709078658815078096}
