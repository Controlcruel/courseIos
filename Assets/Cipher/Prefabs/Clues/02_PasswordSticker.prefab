  m_Script: {fileID: 11500000, guid: 009fff01f5efc6b4ea7e57f122620268, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Cipher.CipherClue
  title: "\u0421\u0442\u0438\u043A\u0435\u0440 \u0441 \u043F\u0430\u0440\u043E\u043B\u0435\u043C"
  time: 18:05
  description: "\u041D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0443 \u0440\u0430\u0431\u043E\u0447\u0435\u0433\u043E
    \u043C\u0435\u0441\u0442\u0430 \u0441\u0442\u0438\u043A\u0435\u0440: \xABNova2024\xBB.
    \u0412 18:05 \u041C\u0430\u0440\u0438\u043D\u0430 \u0432\u0432\u0435\u043B\u0430
    \u044D\u0442\u043E\u0442 \u043F\u0430\u0440\u043E\u043B\u044C \u043D\u0430 \u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u0438\u0437 \u043F\u0438\u0441\u044C\u043C\u0430.
    \u0422\u043E\u0442 \u0436\u0435 \u043F\u0430\u0440\u043E\u043B\u044C \u0441\u0442\u043E\u0438\u0442
    \u0443 \u043D\u0435\u0451 \u043D\u0430 \u043F\u043E\u0447\u0442\u0435 \u0438
    \u0432 \u0431\u0430\u0437\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432,
    \u0434\u0432\u0443\u0445\u0444\u0430\u043A\u0442\u043E\u0440\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0435\u0442."
  lesson: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0441\u043B\u043E\u0436\u043D\u044B\u0435
    \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0430\u0440\u043E\u043B\u0438,
    \u0445\u0440\u0430\u043D\u0438 \u0438\u0445 \u0432 \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u0435
    \u043F\u0430\u0440\u043E\u043B\u0435\u0439 \u0438 \u0432\u043A\u043B\u044E\u0447\u0430\u0439
    \u0434\u0432\u0443\u0445\u0444\u0430\u043A\u0442\u043E\u0440\u043D\u0443\u044E
    \u0430\u0443\u0442\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044E."
  color: {r: 1, g: 0.55, b: 0.2, a: 1}
  surface: 1
